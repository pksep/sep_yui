{
  "name": "@pksep/yui",
  "author": "Perov David",
  "version": "0.1.298",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pksep/sep_yui.git"
  },
  "packageManager": "pnpm@9.9.0",
  "main": "./dist/sep-yui.umd.cjs",
  "module": "./dist/sep-yui.mjs",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "scripts": {
    "build": "pnpm run lint && vue-tsc && vite build",
    "publish:lib": "pnpm run build && cross-env LEFTHOOK_EXCLUDE=protected pnpm changelogen --release --publish",
    "lint": "eslint --fix --ext .ts,.vue src",
    "start:dev": "storybook dev -p 6006",
    "start": "vite",
    "start:preview": "vite preview",
    "build-storybook": "storybook build",
    "deploy-storybook": "pnpm run build-storybook && gh-pages -d storybook-static",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.11",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/source-sans-pro": "^5.2.5",
    "@panzoom/panzoom": "^4.6.2",
    "@pksep/col-cal": "^1.0.4",
    "@tiptap/core": "^3.27.3",
    "@tiptap/extension-image": "^3.27.3",
    "@tiptap/extension-link": "^3.27.3",
    "@tiptap/extension-placeholder": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@tiptap/vue-3": "^3.27.3",
    "@vueuse/components": "^11.3.0",
    "@vueuse/core": "^11.3.0",
    "pdfjs-dist": "^5.7.284",
    "print-js": "^1.6.0",
    "vue": "^3.5.39",
    "vue3-emoji-picker": "^1.1.8",
    "vue3-perfect-scrollbar": "^2.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.7",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-actions": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/blocks": "^8.6.14",
    "@storybook/builder-vite": "^8.6.18",
    "@storybook/test": "^8.6.15",
    "@storybook/vue3": "^8.6.18",
    "@storybook/vue3-vite": "^8.6.18",
    "@types/lodash": "^4.17.24",
    "@types/uuid4": "^2.0.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-typescript": "^13.0.0",
    "changelogen": "^0.6.2",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-storybook": "^0.8.0",
    "eslint-plugin-vue": "^9.33.0",
    "gh-pages": "^5.0.0",
    "lefthook": "^1.13.6",
    "lit": "^3.3.3",
    "lodash": "^4.18.1",
    "sass": "^1.101.0",
    "storybook": "^8.6.18",
    "typescript": "^5.9.3",
    "uuid4": "^2.0.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^3.9.1",
    "vue-tsc": "^2.2.12"
  },
  "peerDependencies": {
    "vue": ">=3"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sep-yui.mjs",
      "require": "./dist/sep-yui.umd.cjs"
    },
    "./styles": "./dist/style.css"
  }
